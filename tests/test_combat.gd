extends SceneTree
const Rules = preload("res://scripts/combat_rules.gd")

func _initialize() -> void:
	assert(Rules.effective_damage(16, 2) == 14, "armor reduces damage")
	assert(Rules.effective_damage(2, 999) == 1, "positive attacks deal at least one")
	assert(Rules.effective_damage(0, 0) == 0, "no attack does no damage")
	assert(Rules.remaining_health(10, 99) == 0, "health never goes negative")
	assert(Rules.remaining_health(95, -3) == 95, "negative damage never heals")
	assert(Rules.in_range(2.35, 2.35), "boundary is in range")
	assert(not Rules.in_range(2.36, 2.35), "beyond boundary is out of range")
	assert(not Rules.in_range(-1.0, 2.35), "invalid distance rejected")
	assert(Rules.guarded_damage(16, 2, false) == 14, "normal damage unchanged")
	assert(Rules.guarded_damage(16, 2, true) == 6, "guard reduces damage")
	assert(Rules.guarded_damage(3, 2, true) == 1, "guard minimum is one")
	assert(Rules.guarded_damage(0, 2, true) == 0, "no attack gives no damage")
	assert(Rules.guarded_damage(16, 1000, true) == 1, "armor and guard cannot negate a hit")
	assert(Rules.may_raise_guard(0.0, 0.0), "guard ready")
	assert(not Rules.may_raise_guard(0.5, 0.0), "active guard cannot be restarted")
	assert(not Rules.may_raise_guard(0.0, 2.0), "guard respects cooldown")
	assert(not Rules.may_raise_guard(INF, 0.0), "infinite duration invalid")
	print("Combat rules: all 17 assertions passed")
	quit()
